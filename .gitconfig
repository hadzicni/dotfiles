[user]
    name = Nikola Hadzic
    email = nikolahadzic7@icloud.com
	signingkey = /Users/hadzicni/.ssh/id_ed25519.pub

[init]
    defaultBranch = main

[core]
    editor = nvim
    autocrlf = input

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[merge]
    conflictstyle = zdiff3

[color]
    ui = auto

[rerere]
    enabled = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgSign = true
